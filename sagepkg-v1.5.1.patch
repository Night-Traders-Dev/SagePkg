+# Creation API
+# ============================================================================
+
+# cJSON_CreateNull() -> cJSON node
+proc cJSON_CreateNull():
+    let node = cJSON()
+    node.type = cJSON_NULL
+    return node
+
+# cJSON_CreateTrue() -> cJSON node
+proc cJSON_CreateTrue():
+    let node = cJSON()
+    node.type = cJSON_True
